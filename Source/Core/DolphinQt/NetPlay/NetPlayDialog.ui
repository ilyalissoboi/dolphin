            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLineEdit" name="chatTypeEdit"/>
          </item>
          <item row="1" column="1">
           <widget class="QPushButton" name="chatSendButton">
            <property name="enabled">
             <bool>false</bool>
            </property>
