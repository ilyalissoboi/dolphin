   </item>
  </layout>
  <action name="actionSavedataNone">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>No Save Data</string>
   </property>
   <property name="toolTip">
    <string>Netplay will start without any save data, and any created save data will be discarded at the end of the Netplay session.</string>
   </property>
  </action>
  <action name="actionSavedataLoadOnly">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="checked">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>Load Host's Save Data Only</string>
   </property>
   <property name="toolTip">
    <string>Netplay will start using the Host's save data, but any save data created or modified during the Netplay session will be discarded at the end of the session.</string>
   </property>
  </action>
  <action name="actionSavedataLoadWrite">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>Load and Write Host's Save Data</string>
   </property>
   <property name="toolTip">
    <string>Netplay will start using the Host's save data, and any save data created or modified during the Netplay session will remain in the Host's local saves.</string>
   </property>
  </action>
  <action name="actionSavedataAllWii">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>Use All Wii Save Data</string>
   </property>
   <property name="toolTip">
    <string>If checked, all Wii saves will be used instead of only the save of the game being started. Useful when switching games mid-session. Has no effect if No Save Data is selected.</string>
   </property>
  </action>
  <action name="actionSyncCodes">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="checked">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>Sync AR/Gecko Codes</string>
   </property>
  </action>
  <action name="actionStrictSettingsSync">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>Strict Settings Sync</string>
   </property>
   <property name="toolTip">
    <string>This will sync additional graphics settings, and force everyone to the same internal resolution.
May prevent desync in some games that use EFB reads. Please ensure everyone uses the same video backend.</string>
   </property>
  </action>
  <action name="actionFixedDelay">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="checked">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>Fair Input Delay</string>
   </property>
   <property name="toolTip">
    <string>Each player sends their own inputs to the game, with equal buffer size for all players, configured by the host.
Suitable for competitive games where fairness and minimal latency are most important.</string>
   </property>
  </action>
  <action name="actionHostInputAuthority">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>Host Input Authority</string>
   </property>
   <property name="toolTip">
    <string>Host has control of sending all inputs to the game, as received from other players, giving the host zero latency but increasing latency for others.
Suitable for casual games with 3+ players, possibly on unstable or high latency connections.</string>
   </property>
  </action>
  <action name="actionGolfMode">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>Golf Mode</string>
   </property>
   <property name="toolTip">
    <string>Identical to Host Input Authority, except the &quot;Host&quot; (who has zero latency) can be switched at any time.
Suitable for turn-based games with timing-sensitive controls, such as golf.</string>
   </property>
  </action>
  <action name="actionChecksumCurrentGame">
   <property name="text">
    <string>Current game</string>
   </property>
  </action>
  <action name="actionChecksumOtherGame">
   <property name="text">
    <string>Other game...</string>
   </property>
  </action>
  <action name="actionChecksumSdCard">
   <property name="text">
    <string>SD Card</string>
   </property>
  </action>
  <action name="actionRecordInputs">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>Record Inputs</string>
   </property>
  </action>
  <action name="actionGolfModeOverlay">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>Show Golf Mode Overlay</string>
   </property>
  </action>
  <action name="actionHideRemoteGBAs">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>Hide Remote GBAs</string>
   </property>
  </action>
 </widget>
