<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>CheatSearchFactoryWidget</class>
 <widget class="QWidget" name="CheatSearchFactoryWidget">
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QGroupBox" name="addressSpaceGroup">
     <property name="title">
      <string>Address Space</string>
     </property>
     <layout class="QVBoxLayout" name="addressSpaceLayout">
      <item>
       <widget class="QRadioButton" name="standardAddressSpaceRadioButton">
        <property name="text">
         <string>Typical GameCube/Wii Address Space</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="standardAddressSpaceLabel">
        <property name="text">
         <string>Sets up the search using standard MEM1 and (on Wii) MEM2 mappings in virtual address space. This will work for the vast majority of games.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="customAddressSpaceRadioButton">
        <property name="text">
         <string>Custom Address Space</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QWidget" name="customAddressSpaceWidget">
        <layout class="QVBoxLayout" name="customAddressSpaceLayout">
         <property name="leftMargin">
          <number>6</number>
         </property>
         <property name="topMargin">
          <number>6</number>
         </property>
         <property name="rightMargin">
          <number>6</number>
         </property>
         <property name="bottomMargin">
          <number>6</number>
         </property>
         <item>
          <widget class="QRadioButton" name="customVirtualAddressSpaceRadioButton">
           <property name="text">
            <string>Use virtual addresses when possible</string>
           </property>
           <property name="checked">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QRadioButton" name="customPhysicalAddressSpaceRadioButton">
           <property name="text">
            <string>Use physical addresses</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QRadioButton" name="customEffectiveAddressSpaceRadioButton">
           <property name="text">
            <string>Use memory mapper configuration at time of scan</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="rangeStartLabel">
           <property name="text">
            <string>Range Start: </string>
           </property>
           <property name="buddy">
            <cstring>customAddressStartLineEdit</cstring>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLineEdit" name="customAddressStartLineEdit">
           <property name="text">
            <string notr="true">0x80000000</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="rangeEndLabel">
           <property name="text">
            <string>Range End: </string>
           </property>
           <property name="buddy">
            <cstring>customAddressEndLineEdit</cstring>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLineEdit" name="customAddressEndLineEdit">
           <property name="text">
            <string notr="true">0x81800000</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="dataTypeGroup">
     <property name="title">
      <string>Data Type</string>
     </property>
     <layout class="QVBoxLayout" name="dataTypeLayout">
      <item>
       <widget class="QComboBox" name="dataTypeComboBox"/>
      </item>
      <item>
       <widget class="QCheckBox" name="alignedCheckBox">
        <property name="text">
         <string>Aligned to data type length</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QPushButton" name="newSearchButton">
     <property name="text">
      <string>New Search</string>
     </property>
     <property name="autoDefault">
      <bool>false</bool>
     </property>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Orientation::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>40</height>
      </size>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
 <tabstops>
  <tabstop>standardAddressSpaceRadioButton</tabstop>
  <tabstop>customAddressSpaceRadioButton</tabstop>
  <tabstop>customVirtualAddressSpaceRadioButton</tabstop>
  <tabstop>customPhysicalAddressSpaceRadioButton</tabstop>
  <tabstop>customEffectiveAddressSpaceRadioButton</tabstop>
  <tabstop>customAddressStartLineEdit</tabstop>
  <tabstop>customAddressEndLineEdit</tabstop>
