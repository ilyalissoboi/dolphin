          <widget class="QGroupBox" name="memoryConditionBox">
           <property name="title">
            <string extracomment="If a condition is set for a breakpoint, the condition becoming true is a prerequisite for triggering the breakpoint.">Condition</string>
           </property>
           <layout class="QHBoxLayout" name="memoryConditionLayout">
            <item>
             <widget class="QRadioButton" name="memoryOnReadRadio">
              <property name="text">
               <string extracomment="This is a selectable condition when adding a breakpoint">Read</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QRadioButton" name="memoryOnWriteRadio">
