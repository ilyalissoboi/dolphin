              </property>
             </widget>
            </item>
            <item>
             <widget class="QRadioButton" name="memoryOnReadWriteRadio">
              <property name="text">
               <string extracomment="This is a selectable condition when adding a breakpoint">Read or Write</string>
              </property>
             </widget>
            </item>
